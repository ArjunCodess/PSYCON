# Copy this template to .env; the resulting .env file is ignored by Git.
HF_TOKEN=hf_replace_with_read_token
PSYCON_PROFILE_KEY=replace_with_a_random_secret_at_least_32_characters

# Local CPU defaults. Change the device values to cuda on a configured GPU server.
PSYCON_WHISPER_MODEL=small
PSYCON_WHISPER_DEVICE=cpu
PSYCON_WHISPER_COMPUTE_TYPE=int8
PSYCON_DIARIZATION_DEVICE=cpu
PSYCON_SPEAKER_DEVICE=cpu

# Week 4 local server. Docker Compose supplies equivalent container-local values.
PSYCON_ENV=development
PSYCON_DATABASE_URL=postgresql://psycon:psycon@localhost:5432/psycon
PSYCON_S3_ENDPOINT_URL=http://localhost:9000
PSYCON_S3_PUBLIC_ENDPOINT_URL=http://localhost:9000
PSYCON_S3_ACCESS_KEY=psycon
PSYCON_S3_SECRET_KEY=replace-with-a-long-object-storage-secret
PSYCON_S3_BUCKET=psycon-research
PSYCON_S3_REGION=us-east-1
PSYCON_SECRET_KEY=replace-with-a-random-flask-secret
PSYCON_BOOTSTRAP_OPERATOR_TOKEN=replace-with-a-random-operator-token
PSYCON_MODEL_ARTIFACT_PATH=results/app_model.json
